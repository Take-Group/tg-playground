# Kontekst budowania to katalog główny — wycinamy wszystko, co nie jest źródłem.

.git/
.gitignore

# Dokumentacja i pamięć projektu
*.md
memory/
skills/

# Backend
backend/.venv/
backend/.env
backend/__pycache__/
backend/**/__pycache__/
