backend/.mypy_cache/
backend/.pytest_cache/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.env*.local
frontend/tsconfig.tsbuildinfo

# Narzędzia
.claude/
.vscode/
.idea/
.DS_Store
